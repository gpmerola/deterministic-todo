<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- LAN only: TLS to the TV box on ports 6466/6467, mDNS discovery via NsdManager. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Low-latency Wi-Fi lock, held only while the remote screen is open. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Away from home the official WiZ app (cloud) is opened instead. -->
    <queries>
        <package android:name="com.wizconnected.wiz2" />
    </queries>
</manifest>
